<?php

/**
 * @file
 * Lets the configured Diffy accounts skip TFA on verified Diffy requests.
 *
 * Hooks are implemented in \Drupal\diffy_trusted_login_tfa\Hook. The functions
 * below only serve Drupal versions before 11.1, which don't support
 * attribute-based hooks; newer versions skip them (#[LegacyHook]).
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\diffy_trusted_login_tfa\Hook\DiffyTrustedLoginTfaHooks;

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
#[LegacyHook]
function diffy_trusted_login_tfa_form_user_login_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service(DiffyTrustedLoginTfaHooks::class)->formUserLoginFormAlter($form, $form_state, $form_id);
}
